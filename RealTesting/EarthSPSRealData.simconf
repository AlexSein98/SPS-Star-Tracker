          ],
          "DatasetPriorities": [
            "array",
            "double",
            0.0
          ]
        }
      },
      {
        "Nametag": "SPS_RealData",
        "Source": "Local/Repos/SPS-Star-Tracker/SPS/SPS_RealData.py",
        "Type": "Python",
        "Active": true,
        "Inst_Parameters": {
          "Planet": [ "EntityRef", "Earth" ],
          "Camera": [ "EntityRef", "CameraAndIMU" ],
          "DataSource": "REPLACE_ME_WITH_CORRECT_PATH",
          "TrueLocationLLA": [ "doubleV3", 30.643609, -96.337302, 86.281612 ],
          "NOTE": "Replace TrueLocationLLA with true north latitude (deg), east longitude (deg), and WGS-84 altitude (meters)",
          "LoopFreqHz": 60.0
        }
      }
    ],
